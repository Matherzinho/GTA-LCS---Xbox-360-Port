diff --git a/src/hanim.cpp b/src/hanim.cpp
index 6bc7c5e..0687bb5 100644
--- a/src/hanim.cpp
+++ b/src/hanim.cpp
@@ -180,11 +180,27 @@ HAnimHierarchy::updateMatrices(void)
 
 		// TODO: here we could update LTM
 
-		if(node->flags & PUSH)
+		// One branch on the two-bit operation preserves the original stack
+		// semantics without GCC's mcrf condition-copy between adjacent tests.
+		// The Xenia interpreter used with XSDK skips that instruction, which
+		// otherwise attaches sibling limbs to the preceding branch.
+		switch(node->flags & (PUSH | POP)){
+		case PUSH:
+			if(sp == &stack[64]){ assert(0 && "HAnim stack overflow"); return; }
 			*sp++ = parentMat;
-		parentMat = curMat;
-		if(node->flags & POP)
+			parentMat = curMat;
+			break;
+		case POP:
+			if(sp == stack){ assert(0 && "HAnim stack underflow"); return; }
 			parentMat = *--sp;
+			break;
+		case PUSH | POP:
+			// Push followed by pop leaves the previous parent unchanged.
+			break;
+		default:
+			parentMat = curMat;
+			break;
+		}
 		assert(sp >= stack);
 		assert(sp <= &stack[64]);
 
